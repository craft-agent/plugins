{
  "name": "@craft-agent/plugins",
  "private": true,
  "description": "One plugin marketplace for Claude Code and Codex that lists every craft-agent tool package, each pinned to its latest release.",
  "author": "craftsamo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craft-agent/plugins.git"
  },
  "homepage": "https://github.com/craft-agent/plugins#readme",
  "bugs": "https://github.com/craft-agent/plugins/issues",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"const fs=require('fs'),{execFileSync}=require('child_process');if(fs.existsSync('.git')){if(fs.existsSync('node_modules/husky'))execFileSync('husky',{stdio:'inherit'});if(fs.existsSync('node_modules/@craftsamo/repo-kit'))execFileSync('repo-kit',['agents','sync'],{stdio:'inherit'})}\""
  },
  "devDependencies": {
    "@craftsamo/repo-kit": "^1.4.0",
    "husky": "^9.1.7",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.3"
}
